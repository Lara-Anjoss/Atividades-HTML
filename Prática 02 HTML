    <main>
        <!-- SEÇÃO 1: DASHBOARD DE OS -->
        <section id="dashboard">
            <h2>Ordens de Serviço em Aberto</h2>
            <table border="1">
                <caption>Lista de manutenções preventivas e corretivas da fábrica</caption>
                <thead>
                    <tr>
                        <th scope="col">ID</th>
                        <th scope="col">Equipamento</th>
                        <th scope="col">Setor</th>
                        <th scope="col">Data Abertura</th>
                        <th scope="col">Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>1042</td>
                        <td>Torno CNC R-200</td>
                        <td>Usinagem</td>
                        <td><time datetime="2026-08-30">30/08/2026</time></td>
                        <td>Em Andamento</td>
                    </tr>
                    <tr>
                        <td>1043</td>
                        <td>Prensa Hidráulica 50T</td>
                        <td>Estamparia</td>
                        <td><time datetime="2026-09-01">01/09/2026</time></td>
                        <td>Aguardando Peças</td>
                    </tr>
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="4">Total de OS Ativas:</td>
                        <td><strong>2</strong></td>
                    </tr>
                </tfoot>
            </table>
        </section>
<!-- SEÇÃO 2: FORMULÁRIO (ABERTURA DE OS) -->
<section id="nova-os">
    <h2>Abertura de Nova Ordem de Serviço</h2>

    <form action="#" method="post" enctype="multipart/form-data">
        <fieldset>
            <legend>Identificação do Solicitante</legend>

            <label for="matricula">Matrícula SENAI:</label><br>
            <input type="text" id="matricula" name="matricula" required pattern="[0-9]{6}" placeholder="Ex: 123456"><br>

            <label for="email">E-mail Corporativo:</label><br>
            <input type="email" id="email" name="email" required placeholder="tecnico@senai.br"><br>
        </fieldset>

        <fieldset>
            <legend>Dados da Ocorrência</legend>

            <label for="equipamento">Equipamento Afetado:</label><br>
            <select id="equipamento" name="equipamento" list="lista-equipamentos" required>
                <option value="">Selecione o equipamento</option>
                <option value="torno">Torno CNC R-200</option>
                <option value="prensa">Prensa Hidráulica 50T</option>
                <option value="robo">Robô Soldador ABB</option>
                <option value="esteira">Esteira Transportadora 1</option>
            </select><br>

            <label for="data-falha">Data da Ocorrência:</label><br>
            <input type="date" id="data-falha" name="data-falha" required><br>

            <label for="hora">Hora da Ocorrência:</label><br>
            <input type="time" id="hora" name="hora" required min="06:00" max="18:00"><br>

            <label for="laudo">Anexar Foto/Laudo Técnico (PDF ou Imagem):</label><br>
            <input type="file" id="laudo" name="laudo" accept="image/*,.pdf"><br>

            <label for="descricao">Descrição Detalhada do Defeito:</label><br>
            <textarea id="descricao" name="descricao" rows="5" cols="40" required minlength="20"
                placeholder="Descreva o problema com no mínimo 20 caracteres."></textarea>
        </fieldset>

        <button type="submit">Registrar Ordem de Serviço</button>
        <button type="reset">Limpar Formulário</button>
    </form>
</section>
</main>

